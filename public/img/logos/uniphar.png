(function () {
    // Pages (URIs) where MS Clarity is allowed to load.
    var allowed = [
        "consumer",
        "flipbook",
        "christmas-preorder",
        "consumer/new-in-2026.html",
        "consumer/suncare.html",
        "consumer/support-irish.html",
        "consumer/skincare.html",
        "consumer/wellness.html",
        "consumer/offers.html",
        "consumer/k-beauty.html",
        "consumer/trending.html",
        "brands",
        "consumer.html",
        "flipbook-christmas-2026",
        "presale/christmas-kids.html",
        "presale/electrical-gifting.html",
        "presale/candles-and-diffusers.html",
        "presale/electrical-gifting.html",
        "presale/gifts-for-her.html",
        "presale/gifts-for-him.html",
        "presale/dental-giftsets.html",
        "presale/winter-warmers.html",
        "presale.html",
        "customer/account/"
    ];

    function trimSlashes(value) {
        return value.replace(/^\/+/, "").replace(/\/+$/, "");
    }

    function pathMatches(currentPath, patternPath) {
        if (!patternPath) {
            return true;
        }
        // Exact match, or match from the end of the path (store code / subfolder in URL).
        return currentPath === patternPath ||
            currentPath.slice(-(patternPath.length + 1)) === "/" + patternPath;
    }

    function normalizeQuery(params) {
        var pairs = [];
        params.forEach(function (value, key) {
            pairs.push(key + "=" + value);
        });
        pairs.sort();
        return pairs.join("&");
    }

    var currentPath = trimSlashes(window.location.pathname);
    var currentQuery = normalizeQuery(new URLSearchParams(window.location.search));

    var isAllowed = allowed.some(function (uri) {
        var parts = uri.split("?");
        var patternPath = trimSlashes(parts[0]);
        var patternQuery = normalizeQuery(new URLSearchParams(parts[1] || ""));
        return pathMatches(currentPath, patternPath) && currentQuery === patternQuery;
    });

    if (!isAllowed) {
        return;
    }

    (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "xmav9e4xoc");
})();
</script>
