{
  "name": "video-template",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "remotion studio",
    "start": "remotion studio",
    "build": "remotion bundle",
    "render": "remotion render",
    "render:project": "node scripts/render-local.mjs",
    "still": "node scripts/still.mjs",
    "wizard": "node scripts/dev.mjs",
    "gallery": "vite --config vite.gallery.config.ts",
