    "@remotion/motion-blur": "4.0.496",
    "@remotion/player": "4.0.496",
    "@remotion/transitions": "4.0.496",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remotion": "4.0.496",
    "sirv": "^2.0.4",
    "zm-motion": "github:mattbwesson/zm-motion"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.0.0",
